VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 익명 로그인(Anonymous)은 사용하지 않습니다.
# 토스 로그인 → 서버 Custom Token → signInWithCustomToken 만 사용합니다.

# 미니앱이 호출하는 로그인 API 주소 (공개 HTTPS).
# 토스 앱 WebView에서는 localhost / 상대경로가 동작하지 않아요.
# 예: https://woori-secret-space.onrender.com
# 설정 후 반드시 npm run build && ait deploy 로 다시 올려야 반영됩니다.
VITE_TOSS_AUTH_API_URL=

# 콘솔 > 사용자 정보 불러오기 에 등록한 동의 키 (실명 USER_NAME)
# 예: cud_delivery
VITE_TOSS_CONSENTED_DATA_KEY=

# ----- 아래는 서버 전용 (VITE_ 금지, 클라이언트에 노출됨) -----
AUTH_SERVER_PORT=4000
AUTH_CORS_ORIGINS=http://localhost:5173,https://woori-secret-space.web.tossmini.com,https://woori-secret-space.private-web.tossmini.com,https://woori-secret-space.apps.tossmini.com,https://woori-secret-space.private-apps.tossmini.com

TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im

# 이메일로 받은 AES-256 키(Base64)와 AAD. 파일 또는 값 중 하나를 사용하세요.
TOSS_DECRYPT_KEY=
TOSS_AAD=
TOSS_DECRYPT_KEY_FILE=secrets/toss-decrypt.key
TOSS_AAD_FILE=secrets/toss-aad.txt

# mTLS (앱인토스 서버 API 호출용) — 로컬은 파일, Render는 PEM 문자열
TOSS_MTLS_CERT_FILE=secrets/mtls/client.crt
TOSS_MTLS_KEY_FILE=secrets/mtls/client.key
TOSS_MTLS_CA_FILE=

# Firebase Admin (Custom Token 발급) — Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키
# Render: JSON 전체를 FIREBASE_SERVICE_ACCOUNT_JSON 에 한 줄로 넣거나 Base64로 넣으세요.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json

# Render 배포 시 (파일 대신 환경변수로 PEM 전체 내용 붙여넣기, 줄바꿈은 \n 가능)
# TOSS_MTLS_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# TOSS_MTLS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# TOSS_DECRYPT_KEY=(이메일로 받은 Base64 AES 키)
# TOSS_AAD=(이메일로 받은 AAD)

# 콘솔에 등록한 연결 끊기 콜백 Basic Auth (선택)
TOSS_UNLINK_BASIC_USER=
TOSS_UNLINK_BASIC_PASSWORD=
