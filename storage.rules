rules_version = '2';

// Firebase Console → Storage → Rules 에 배포하거나
// `firebase deploy --only storage` 로 적용하세요.
service firebase.storage {
  match /b/{bucket}/o {
    function isLoggedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/jpeg')
        || request.resource.contentType.matches('image/jpg')
        || request.resource.contentType.matches('image/png')
        || request.resource.contentType.matches('image/webp')
        || request.resource.contentType.matches('image/gif')
        || request.resource.contentType.matches('image/heic')
        || request.resource.contentType.matches('image/heif');
    }

    // 프론트 MAX_UPLOAD_BYTES(5MB)와 동일
    function isUnderSizeLimit() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }

    function canWriteImage() {
      return isLoggedIn() && isImage() && isUnderSizeLimit();
    }

    // 방 스토리 사진
    match /rooms/{roomId}/{allPaths=**} {
      allow read: if isLoggedIn();
      allow create, update: if canWriteImage();
      allow delete: if isLoggedIn();
    }

    // 그 외 경로도 동일 정책 (실수 업로드 방지)
    match /{allPaths=**} {
      allow read: if isLoggedIn();
      allow create, update: if canWriteImage();
      allow delete: if isLoggedIn();
    }
  }
}
